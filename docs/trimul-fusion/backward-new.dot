digraph G {
graph [rankdir=TB,compound=true,newrank=true,bgcolor="white",pad="0.25",nodesep="0.20",ranksep="0.32",fontname="sans-serif",fontsize=16,label="현재 설치된 H100 · Backward · L384",labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="white",color="#b6c4cf",fontname="sans-serif",fontsize=11,margin="0.10,0.07"];
edge [color="#566d7b",arrowsize=0.65,fontname="sans-serif",fontsize=9];
dy [label="gy + 저장된 forward buffers",shape=oval,color="#88989d",fillcolor="#f5f7f8"];
subgraph cluster_gew { label="B1 · _gate_elem_bwd_ew_kernel\nTriton · 1 kernel"; color="#2868ba"; fillcolor="#eef5ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
gew0 [label="v = gy × dropout_scale",shape=box,color="#2868ba",fillcolor="white"];
gew1 [label="dproj = v × gate\ndglogit = v × proj × gate × (1 − gate)",shape=box,color="#2868ba",fillcolor="white"];
gew0 -> gew1 [label=""];
}
dy -> gew0 [label="",lhead=cluster_gew];
dp [label="dproj [M,128] · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
dgl [label="dglogit [M,128] · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
gew1 -> dp [label=""];
gew1 -> dgl [label=""];
subgraph cluster_dwg { label="B2 · cuBLAS mm\n별도 GEMM 호출"; color="#8655ad"; fillcolor="#f7f0ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
dwg0 [label="dWg = x_nᵀ @ dglogit",shape=box,color="#8655ad",fillcolor="white"];
}
dgl -> dwg0 [label="",lhead=cluster_dwg];
subgraph cluster_prep { label="별도 small-weight 연산 · Inductor\n복수 생성 커널 가능"; color="#727e86"; fillcolor="#f3f5f6"; style="rounded,dashed,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
prep0 [label="s = Σk(Wp × γout)\nb2 = Σk(Wp × βout)",shape=box,color="#727e86",fillcolor="white"];
}
subgraph cluster_cr { label="B3 · Inductor 생성 Triton reduction\n…div_mul_sub_sum…rows_dgrad…"; color="#2868ba"; fillcolor="#eef5ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
cr0 [label="c1 = Σn[dproj × (proj − b2)] / 256\nc2 = Σn[dproj × s] / 256",shape=box,color="#2868ba",fillcolor="white"];
}
dp -> cr0 [label="",lhead=cluster_cr];
prep0 -> cr0 [label="",lhead=cluster_cr];
corr [label="c1, c2 [M] · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
cr0 -> corr [label=""];
subgraph cluster_outdx { label="B4 · _DgradLNRowsSm90\nCuTe · 1 kernel"; color="#168269"; fillcolor="#eaf8f2"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
outdx0 [label="acc = dproj @ Wp  [GEMM]",shape=box,color="#168269",fillcolor="white"];
outdx1 [label="acc = acc × γout",shape=box,color="#168269",fillcolor="white"];
outdx2 [label="acc = acc − c2 − xhat × c1",shape=box,color="#168269",fillcolor="white"];
outdx3 [label="dtri = rstdout × acc  [epilogue]",shape=box,color="#168269",fillcolor="white"];
outdx0 -> outdx1 [label=""];
outdx1 -> outdx2 [label=""];
outdx2 -> outdx3 [label=""];
}
dp -> outdx0 [label="",lhead=cluster_outdx];
corr -> outdx2 [label="",lhead=cluster_outdx];
dtri [label="dtri [256,L,L] · HBM\nM-major 직접 store · dx_normed buffer 없음",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
outdx3 -> dtri [label=""];
subgraph cluster_tw { label="B5a · cuBLAS mm\n별도 GEMM 호출"; color="#8655ad"; fillcolor="#f7f0ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
tw0 [label="T = dprojᵀ @ xhat",shape=box,color="#8655ad",fillcolor="white"];
}
dp -> tw0 [label="",lhead=cluster_tw];
T [label="T [128,256] · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
tw0 -> T [label=""];
subgraph cluster_tail { label="B5b · Inductor reductions + GEMV\n여러 커널 / GEMM과 미융합"; color="#727e86"; fillcolor="#f3f5f6"; style="rounded,dashed,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
tail0 [label="db = Σm dproj",shape=box,color="#727e86",fillcolor="white"];
tail1 [label="dWp = γout × T + db ⊗ βout\ndγout = Σn(Wp × T)\ndβout = db @ Wp",shape=box,color="#727e86",fillcolor="white"];
tail0 -> tail1 [label=""];
}
T -> tail1 [label="",lhead=cluster_tail];
dp -> tail0 [label="",lhead=cluster_tail];
subgraph cluster_cb0 { label="B6a · GemmDefaultSm90\n별도 GEMM 호출"; color="#168269"; fillcolor="#eaf8f2"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
cb00 [label="dleft[:h] = dtri[:h] @ right[:h]",shape=box,color="#168269",fillcolor="white"];
}
dtri -> cb00 [label="",lhead=cluster_cb0];
subgraph cluster_cb1 { label="B6b · GemmDefaultSm90\n별도 GEMM 호출"; color="#168269"; fillcolor="#eaf8f2"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
cb10 [label="dright[:h] = dtri[:h]ᵀ @ left[:h]",shape=box,color="#168269",fillcolor="white"];
}
dtri -> cb10 [label="",lhead=cluster_cb1];
subgraph cluster_cb2 { label="B6c · GemmDefaultSm90\n별도 GEMM 호출"; color="#168269"; fillcolor="#eaf8f2"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
cb20 [label="dleft[h:] = right[h:] @ dtri[h:]ᵀ",shape=box,color="#168269",fillcolor="white"];
}
dtri -> cb20 [label="",lhead=cluster_cb2];
subgraph cluster_cb3 { label="B6d · GemmDefaultSm90\n별도 GEMM 호출"; color="#168269"; fillcolor="#eaf8f2"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
cb30 [label="dright[h:] = left[h:] @ dtri[h:]",shape=box,color="#168269",fillcolor="white"];
}
dtri -> cb30 [label="",lhead=cluster_cb3];
dlr [label="dleft / dright · HBM\n4 GEMM이 두 최종 buffer의 slice에 직접 기록\nbackward cat 2회 없음",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
cb00 -> dlr [label=""];
cb10 -> dlr [label=""];
cb20 -> dlr [label=""];
cb30 -> dlr [label=""];
subgraph cluster_dc { label="B7 · _dconcat_kernel\nTriton · 1 kernel"; color="#2868ba"; fillcolor="#eef5ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
dc0 [label="dleft/right × pair_mask",shape=box,color="#2868ba",fillcolor="white"];
dc1 [label="gL/R = sigmoid(saved gL/R logits)",shape=box,color="#2868ba",fillcolor="white"];
dc2 [label="dpL/R = dleft/right × gL/R\ndgL/R = dleft/right × pL/R × gL/R × (1−gL/R)",shape=box,color="#2868ba",fillcolor="white"];
dc3 [label="4 gradient를 dconc에 packed store",shape=box,color="#2868ba",fillcolor="white"];
dc0 -> dc1 [label=""];
dc1 -> dc2 [label=""];
dc2 -> dc3 [label=""];
}
dlr -> dc0 [label="",lhead=cluster_dc];
dconc [label="dconc [1024,M] · HBM\n이 buffer는 존재함",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
dc3 -> dconc [label=""];
subgraph cluster_wgrad { label="B8 · cuBLAS mm\n4 입력 weight gradient를 묶은 GEMM"; color="#8655ad"; fillcolor="#f7f0ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
wgrad0 [label="dWs = dconc @ x_n",shape=box,color="#8655ad",fillcolor="white"];
}
dconc -> wgrad0 [label="",lhead=cluster_wgrad];
dws [label="dWL,dWLg,dWR,dWRg\nslice / transpose / copy 별도",shape=note,color="#b6c4cf",fillcolor="white"];
wgrad0 -> dws [label=""];
subgraph cluster_gx { label="B9 · cuBLAS mm\n별도 GEMM 호출"; color="#8655ad"; fillcolor="#f7f0ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
gx0 [label="dx_gate = dglogit @ Wgᵀ",shape=box,color="#8655ad",fillcolor="white"];
}
dgl -> gx0 [label="gate 분기",style=dashed,color="#84929a",constraint=false];
dxgate [label="dx_gate [M,128] · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
gx0 -> dxgate [label=""];
subgraph cluster_fx { label="B10 · cuBLAS addmm_\nGEMM + C-add epilogue"; color="#8655ad"; fillcolor="#f7f0ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
fx0 [label="acc = dconcᵀ @ W_stack",shape=box,color="#8655ad",fillcolor="white"];
fx1 [label="dx_n = acc + dx_gate\n같은 dx_gate buffer에 in-place 기록",shape=box,color="#8655ad",fillcolor="white"];
fx0 -> fx1 [label=""];
}
dconc -> fx0 [label="",lhead=cluster_fx];
dxgate -> fx1 [label="",lhead=cluster_fx];
dxn [label="dx_n [M,128] · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
fx1 -> dxn [label=""];
subgraph cluster_lib { label="B11 · layer_norm_bwd_dx_fused\nTriton · 1 kernel"; color="#2868ba"; fillcolor="#eef5ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
lib0 [label="입력 LN xhat 재계산; dx_n × γin",shape=box,color="#2868ba",fillcolor="white"];
lib1 [label="row c1/c2 reduction → dpair_LN\ndγin / dβin atomic reduction",shape=box,color="#2868ba",fillcolor="white"];
lib0 -> lib1 [label=""];
}
dxn -> lib0 [label="",lhead=cluster_lib];
dln [label="dpair_LN · HBM",shape=cylinder,color="#b78b43",fillcolor="#fff7df"];
lib1 -> dln [label=""];
subgraph cluster_add { label="B12 · Inductor Triton add_view\nresidual gradient 누적은 별도 kernel"; color="#2868ba"; fillcolor="#eef5ff"; style="rounded,filled"; penwidth=2; fontsize=11; fontname="monospace"; margin=12;
add0 [label="dpair = dpair_LN + gy",shape=box,color="#2868ba",fillcolor="white"];
}
dln -> add0 [label="",lhead=cluster_add];
dy -> add0 [label="residual identity gradient",style=dashed,color="#84929a",constraint=false];
end [label="dpair + 모든 parameter gradients",shape=oval,color="#88989d",fillcolor="#f5f7f8"];
add0 -> end [label=""];
}