+                        mask=mask, other=0).to(tl.float32)
+            dy = tl.load(DY + rows[:, None] * stride_r + cols[None, :] * stride_c,
+                         mask=mask, other=0).to(tl.float32)
+            if HAS_ROWSCALE:
+                dy = dy * rs[:, None]
+            w = tl.load(W + cols, mask=col_mask, other=0.0).to(tl.float32)
+            xhat = tl.where(mask, (x - mean[:, None]) * rstd[:, None], 0.0)
