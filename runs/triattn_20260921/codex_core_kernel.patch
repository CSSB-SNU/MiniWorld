+#include <torch/types.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+
+#include <cutlass/cluster_launch.hpp>
+
+#include "triattn_m1_sm90.cuh"
+
+namespace ta_core_broadcast {
+
+struct Args {
+    torch::Tensor const& q; torch::Tensor const& k; torch::Tensor const& v;
+    torch::Tensor const& bias;                                   // staged [B*H, nq, 4*nk, 4096] fp32 (stage_bias_m1)
+    double scale;
+    torch::Tensor& out;
+    int* fix;                                                    // [1 + 3 * n_ctas] int32: fix-list counter + (qtile, rowgroup, bh) triples (counter zeroed by stage_bias)
+    int* fix_total;                                              // int32[2] device census accumulator
+    uint32_t const* maskw; uint8_t const* rowkind; int const* kcend; int const* kcstart;   // key-mask staging (null: no mask)
+    int const* rowkc0; int const* rowkc1;                        // per-row first / one-past-last attended 32-key column
+    unsigned long long* trace = nullptr;
+    int force_fix = 0;                                           // debug (env TRIATTN_M1_FORCE_SAFE=1): every tile through the SAFE pass
+};
+
+using RunFn = void (*)(Args const&);
+
+template <class T>
+void launch_m1(Args const& a) {
+    using namespace cute;
+    using Element = typename T::Element;
+    int const B = a.q.size(0), N = a.q.size(1), H = a.q.size(2), S = a.q.size(3), D = a.q.size(4);
+    TORCH_CHECK(D == T::kHeadDim, "head dim must be 32");
+    typename T::ShapeQK shape_qk = make_shape(S, D, H, N, B);
+    auto stride_of = [](torch::Tensor const& t) { return typename T::StrideQK{t.stride(3), _1{}, t.stride(2), t.stride(1), t.stride(0)}; };
+    Tensor mQ = make_tensor(make_gmem_ptr(reinterpret_cast<Element const*>(a.q.data_ptr())), shape_qk, stride_of(a.q));
+    Tensor mK = make_tensor(make_gmem_ptr(reinterpret_cast<Element const*>(a.k.data_ptr())), shape_qk, stride_of(a.k));
+    Tensor mV = make_tensor(make_gmem_ptr(reinterpret_cast<Element const*>(a.v.data_ptr())), shape_qk, stride_of(a.v));
+    int const n_qtiles = (S + T::kBlockM - 1) / T::kBlockM;
+    int const n_ktiles = (S + T::kBlockN - 1) / T::kBlockN;
+    TORCH_CHECK(a.bias.dim() == 4 && a.bias.size(0) == B * H && a.bias.size(1) == n_qtiles && a.bias.size(2) == 4 * (n_ktiles + 1) && a.bias.size(3) == T::kSlotElems
