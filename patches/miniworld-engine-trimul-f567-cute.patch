     # epilogue restriction: the same tile is valid in the other GEMM families.
     return tiles + [c for c in plain_sm90_candidates()
                     if not c.is_dynamic_persistent and c.tile_m != 192 and c not in tiles]
+
+
+def f567_candidates(kp, kg, shared_memory_limit):
+    """Only consumed knobs: M/N MMA tiles, K transfer chunk, grouped M order.
+
+    SM90 WGMMA M atom is 64; each atom uses 128 threads. Input arrays each
+    have 1024-byte allocator alignment, plus the barrier and one reusable
+    residual/output staging buffer. No pipeline-depth
+    knob: this kernel stages each GEMM's complete K independently.
+    """
+    from itertools import product
+    result=[]
+    for tm,tn,tk,gm in product((64,128,192,256),(32,64,128),(32,64,128),(1,2,4,8)):
+        pg=(kg+tk-1)//tk*tk; pp=(kp+tk-1)//tk*tk
+        sizes=(tm*pg*2,tm*pp*2,tn*pg*2,tn*pp*2,tm*tn*2)
+        required=1024+sum((v+1023)//1024*1024 for v in sizes)
+        if required<=shared_memory_limit:
+            result.append(dict(tile_m=tm,tile_n=tn,tile_k=tk,group_m=gm))
+    return result
